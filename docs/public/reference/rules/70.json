","823.1.c.3","823.2","823.3","824","824.1","824.1.a","824.1.b","824.1.b.1","824.1.b.2","824.1.c","824.1.c.1","824.1.d","824.2","825","825.1","825.2","825.3","825.3.a","825.3.b","825.4","825.5","826","826.1","826.2","826.3","826.4","826.4.a","826.4.b","826.5","826.6","827","827.1","827.1.a","827.1.b","827.1.b.1","827.1.c","827.1.c.1","827.1.c.2","827.1.c.3","827.1.c.4","827.1.c.5","827.2","827.2.a","827.3","827.4","828","828.1","828.1.a","828.1.b","828.1.b.1","828.1.b.2","828.1.c","828.1.d","828.2","829","829.1","829.1.a","829.1.b","829.1.b.1","829.1.b.2","829.1.c","829.1.c.1","829.1.c.2","829.1.c.3","829.2","830","830.1","830.1.a","830.1.b","830.1.b.1","830.1.b.2","830.1.b.3","830.2","830.3","831","831.1","831.1.a","831.1.b","831.1.c","831.1.c.1","831.1.c.2","831.1.c.3","831.1.d","831.1.d.1","831.2","831.3","832","832.1","832.1.a","832.1.b","832.1.b.1","832.1.c","832.1.c.1","832.1.c.2","832.1.c.3","832.1.c.4","832.1.d","832.1.d.1","832.2","832.2.a","832.3"]},{"number":"701","page":115,"level":3,"paragraphs":[["rule","Buffs"]],"section":["701","702","702.1","702.2","702.2.a","702.2.b","702.2.b.1","702.2.b.2","702.3","702.3.a","703","704","704.1","705","705.1"]},{"number":"702","page":115,"level":0,"paragraphs":[["rule","Buffs are counters placed on Units."]]},{"number":"702.1","page":116,"level":0,"paragraphs":[["rule","Buffs can be tracked with a buff reminder card from a Riftbound booster pack or with any spare object in your surroundings."]]},{"number":"702.2","page":116,"level":0,"paragraphs":[["rule","Buffs can be added or spent."]]},{"number":"702.2.a","page":116,"level":0,"paragraphs":[["rule","To Buff a Unit, a player chooses a Unit and then places a buff on it. That Unit is Buffed for as long as the buff remains on it."]]},{"number":"702.2.b","page":116,"level":0,"paragraphs":[["rule","Spending a Buff removes a single Buff counter from a Unit."]]},{"number":"702.2.b.1","page":116,"level":0,"paragraphs":[["rule","A buff cannot be spent from a Unit that does not have a buff."]]},{"number":"702.2.b.2","page":116,"level":0,"paragraphs":[["rule","A player can only spend buffs on units they control."]]},{"number":"702.3","page":116,"level":0,"paragraphs":[["rule","There can only be one Buff on a Unit at a time."]]},{"number":"702.3.a","page":116,"level":0,"paragraphs":[["rule","If a Buff is added, or instructed to be added, on a Unit that already has a Buff, it is not placed instead."]]},{"number":"703","page":116,"level":0,"paragraphs":[["rule","Each Buff individually contributes +1 Might to a Unit."]]},{"number":"704","page":116,"level":0,"paragraphs":[["rule","Buffs are Game Objects and may be referenced, counted, or affected by other effects as specified."]]},{"number":"704.1","page":116,"level":0,"paragraphs":[["rule","Buffs are counters, and thus are not targeted by spells and abilities."],["reference","See rule 741. Counters for more information."]]},{"number":"705","page":116,"level":0,"paragraphs":[["rule","If a Unit leaves play, remove all Buffs from it."]]},{"number":"705.1","page":116,"level":0,"paragraphs":[["rule","Champions do not retain Buffs in the Champion Zone, even if they return there somehow."]]},{"number":"706","page":116,"level":3,"paragraphs":[["rule","Mighty"]],"section":["706","707","708","709","710","711"]},{"number":"707","page":116,"level":0,"paragraphs":[["rule","Mighty is a description that applies to some units. Other game effects can check whether a unit is Mighty."]]},{"number":"708","page":116,"level":0,"paragraphs":[["rule","A Unit \"is Mighty\" as long as its Might is 5 or greater."]]},{"number":"709","page":116,"level":0,"paragraphs":[["rule","A Unit \"becomes Mighty\" at the moment its Might changes from being less than 5 to being 5 or greater."],["example","Example: A Unit with Might 4 that gets +1 [M] becomes Mighty."],["example","Example: A Unit with Might 5 that gets +1 [M] does not become Mighty, because it was already Mighty."]]}]}
