,"491.8.b.1","491.8.c","491.8.c.1","491.8.c.2","491.8.d","491.8.d.1","491.8.d.2","491.8.d.3","491.8.e","491.8.f","491.8.f.1","491.8.g","491.8.g.1","491.8.g.2","491.8.h","491.8.i","649","650","651","651.1","651.2","651.3","651.4","652","652.1","652.2","652.2.a","652.2.b","652.2.c","652.3","652.4","652.5","652.5.a","652.5.a.1","652.5.b","652.5.b.1","652.5.b.2","652.5.c","652.5.c.1","652.5.c.2"]},{"number":"301","page":35,"level":3,"paragraphs":[["rule","The Turn"]],"section":["301","302","303","303.1","303.2","303.2.a","304","305","306","307","308","308.1","308.1.a","308.2","309","309.1","309.1.a","309.2","310","310.1","310.1.a","310.2","310.3","310.4","311","312","312.1","312.1.a","312.1.b","312.1.b.1","312.2","312.2.a","312.2.b","312.2.c","312.2.d","312.3","313","313.1","313.1.a","313.2","313.3","313.4","313.5","314","315","315.1","315.1.a","315.1.b","315.2","315.2.a","315.2.a.1","315.2.b","315.2.b.1","315.2.b.2","315.2.b.3","315.3","315.3.a","315.3.b","315.3.b.1","315.4","315.4.a","315.4.b","315.4.b.1","315.4.b.2","316","316.1","316.2","316.3","316.4","316.5","316.5.a","316.5.b","316.5.b.1","316.6","316.7","316.7.a","316.7.b","316.7.c","316.7.d","316.7.e","316.7.f","316.8","316.8.a","316.8.a.1","316.8.b","316.8.b.1","316.8.b.1.a","316.8.c","316.9","316.9.a","316.9.b","317","317.1","317.1.a","317.1.b","317.2","317.2.a","317.2.b","317.2.c","317.2.d","317.2.e","317.2.f","317.3"]},{"number":"302","page":35,"level":0,"paragraphs":[["rule","Play continues cyclically until one player wins."]]},{"number":"303","page":35,"level":0,"paragraphs":[["rule","The phases of a turn are rigid, but the actions taken during those steps can be done in any order, unless otherwise specified."]]},{"number":"303.1","page":35,"level":0,"paragraphs":[["rule","Game Actions of any nature are performed one at a time and are executed completely."]]},{"number":"303.2","page":35,"level":0,"paragraphs":[["rule","Game Actions cannot be performed simultaneously for any reason."]]},{"number":"303.2.a","page":35,"level":0,"paragraphs":[["rule","If one or more game actions, game effects, or Triggered Abilities are activated simultaneously, then Turn Order is referenced to organize the sequence of actions, starting with the current Turn Player."],["reference","See rule 382. Triggered Abilities for more information."]]},{"number":"304","page":35,"level":0,"paragraphs":[["rule","The Turn Player is the player taking the current turn."]]},{"number":"305","page":35,"level":0,"paragraphs":[["rule","When there are no items on the Chain and the Turn Player cannot or chooses not to perform any Discretionary Actions, the current phase or step of the turn ends and the next phase, step, or turn begins."]]},{"number":"306","page":35,"level":0,"paragraphs":[["rule","The Turn Player changes when the current Turn Player reaches the End of all of the Phases of their Turn."]]},{"number":"307","page":35,"level":0,"paragraphs":[["rule","States of the Turn"]]},{"number":"308","page":36,"level":0,"paragraphs":[["rule","At any given time, the turn is in either a Neutral State or a Showdown State."]]},{"number":"308.1","page":36,"level":0,"paragraphs":[["rule","If a Showdown or Combat is in progress, the turn is in a Showdown State."]]},{"number":"308.1.a","page":36,"level":0,"paragraphs":[["rule","Only cards and abilities with the Action or Reaction keywords can be played or activated in a Showdown State."]]},{"number":"308.2","page":36,"level":0,"paragraphs":[["rule","If no Showdown or Combat is in progress, the turn is in a Neutral State."]]},{"number":"309","page":36,"level":0,"paragraphs":[["rule","At any given time, the turn is in either an Open State or a Closed State."]]},{"number":"309.1","page":36,"level":0,"paragraphs":[["rule","If a Chain exists, the turn is in a Closed State."]]},{"number":"309.1.a","page":36,"level":0,"paragraphs":[["rule","Only cards and abilities with the Reaction keyword can be played or activated in a Closed State."]]},{"number":"309.2","page":36,"level":0,"paragraphs":[["rule","If no Chain exists, the turn is in an Open State."]]}]}
